PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/smarthr
JWT_SECRET=smarthr_super_secret_jwt_key_2024_change_in_production
JWT_EXPIRES_IN=7d
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ─── EMAIL / OTP CONFIG ───────────────────────────────
# EMAIL_MODE=console  → OTP printed to terminal (default, no setup needed)
# EMAIL_MODE=smtp     → Real email via SMTP
EMAIL_MODE=console
OTP_EXPIRES_MINUTES=10

# SMTP settings (only used if EMAIL_MODE=smtp)
# For Mailtrap: https://mailtrap.io → Inboxes → SMTP Settings
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_password
EMAIL_FROM=SmartHR <noreply@smarthr.com>
